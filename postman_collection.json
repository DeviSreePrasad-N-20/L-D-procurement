{
  "info": {
    "name": "L&D Procurement Optimizer API",
    "description": "Collection for all available API endpoints",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://l-d-procurement.onrender.com/api/v1",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Login (Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.accessToken) {",
                  "    pm.collectionVariables.set(\"accessToken\", jsonData.data.accessToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@demo.local\",\n  \"password\": \"Password123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          }
        },
        {
          "name": "Get Current User Profile",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            }
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"<YOUR_REFRESH_TOKEN>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/refresh",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "refresh"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "2. Operations & Dashboards",
      "item": [
        {
          "name": "Get Operations Dashboard",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/operations/dashboard",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "operations",
                "dashboard"
              ]
            }
          }
        },
        {
          "name": "Get Replenishment Scenario",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/operations/replenishment?demandMultiplier=1.5",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "operations",
                "replenishment"
              ],
              "query": [
                {
                  "key": "demandMultiplier",
                  "value": "1.5"
                }
              ]
            }
          }
        },
        {
          "name": "Get Supplier Scorecards",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/operations/suppliers/scorecards",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "operations",
                "suppliers",
                "scorecards"
              ]
            }
          }
        },
        {
          "name": "Export Inventory CSV",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/operations/reports/inventory.csv",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "operations",
                "reports",
                "inventory.csv"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "3. Purchase Requests & Approvals",
      "item": [
        {
          "name": "List My Requests",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/operations/purchase-requests/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "operations",
                "purchase-requests",
                "me"
              ]
            }
          }
        },
        {
          "name": "Create Purchase Request",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"itemId\": \"<ITEM_ID_HERE>\",\n  \"quantity\": 10\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/operations/purchase-requests",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "operations",
                "purchase-requests"
              ]
            }
          }
        },
        {
          "name": "List Approvals",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/operations/approvals",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "operations",
                "approvals"
              ]
            }
          }
        },
        {
          "name": "Update Approval (Approve/Reject)",
          "request": {
            "method": "PATCH",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"outcome\": \"APPROVED\",\n  \"reason\": \"Looks good\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/operations/approvals/<APPROVAL_ID_HERE>",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "operations",
                "approvals",
                "<APPROVAL_ID_HERE>"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "4. Inventory Items & Forecasts",
      "item": [
        {
          "name": "List Items (Catalog)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/items?category=COURSE_LICENCE&pageSize=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "items"
              ],
              "query": [
                {
                  "key": "category",
                  "value": "COURSE_LICENCE"
                },
                {
                  "key": "pageSize",
                  "value": "10"
                }
              ]
            }
          }
        },
        {
          "name": "Get Item Details",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/items/<ITEM_ID_HERE>",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "items",
                "<ITEM_ID_HERE>"
              ]
            }
          }
        },
        {
          "name": "Create Item",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sku\": \"NEW-101\",\n  \"name\": \"New Training Material\",\n  \"category\": \"TRAINING_MATERIAL\",\n  \"unit\": \"piece\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/items",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "items"
              ]
            }
          }
        },
        {
          "name": "Generate Forecast",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/<ITEM_ID_HERE>/forecasts/generate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "<ITEM_ID_HERE>",
                "forecasts",
                "generate"
              ]
            }
          }
        },
        {
          "name": "Get Outcomes & Accuracy",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/operations/outcomes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "operations",
                "outcomes"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "5. System Governance",
      "item": [
        {
          "name": "List Users",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users"
              ]
            }
          }
        },
        {
          "name": "Create User",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"New User\",\n  \"email\": \"new@demo.local\",\n  \"password\": \"Password123!\",\n  \"roleName\": \"EMPLOYEE\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users"
              ]
            }
          }
        },
        {
          "name": "List Audit Logs",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/audit-logs",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "audit-logs"
              ]
            }
          }
        },
        {
          "name": "List Notifications",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/notifications",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "notifications"
              ]
            }
          }
        },
        {
          "name": "Mark Notification Read",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/notifications/<NOTIFICATION_ID_HERE>/read",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "notifications",
                "<NOTIFICATION_ID_HERE>",
                "read"
              ]
            }
          }
        }
      ]
    }
  ]
}
